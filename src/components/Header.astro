---
const sections = [
  { slug: 'concept', name: 'Concept' },
  { slug: 'math', name: 'Math' },
  { slug: 'code', name: 'Code' },
  { slug: 'compare', name: 'Compare' },
  { slug: 'papers', name: 'Papers' },
];
---

<header class="border-b border-gray-200 bg-white/95 backdrop-blur-sm sticky top-0 z-10">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-mono text-lg text-xgb-ink font-bold no-underline tracking-tight">
      <span class="text-xgb-lime">&#x25CF;</span> dbscan
    </a>
    <details class="relative md:hidden">
      <summary class="list-none min-h-11 min-w-11 inline-flex items-center justify-center cursor-pointer font-mono text-xs uppercase tracking-wider" aria-label="Open navigation">Menu</summary>
      <div class="absolute right-0 top-full mt-2 w-48 rounded border border-gray-200 bg-white p-2 shadow-lg flex flex-col z-20">
        {sections.map(s => (
          <a href={`/${s.slug}/`} class="sidebar-link font-mono text-xs uppercase tracking-wider min-h-11">{s.name}</a>
        ))}
        <a href="/about/" class="sidebar-link font-mono text-xs uppercase tracking-wider min-h-11">about</a>
      </div>
    </details>
    <div class="hidden md:flex gap-1 text-sm">
      {sections.map(s => (
        <a href={`/${s.slug}/`} class="sidebar-link font-mono text-xs uppercase tracking-wider">
          {s.name}
        </a>
      ))}
    </div>
    <a href="/about/" class="text-sm text-xgb-muted hover:text-xgb-ink no-underline hidden md:block font-mono">about</a>
  </nav>
</header>
